# FOFA credentials. FOFA_API_KEY is preferred; FOFA_KEY is a legacy alias.
FOFA_API_KEY=
FOFA_KEY=
FOFA_EMAIL=

# Shodan credential for `--engine shodan` (and the merged `-e all` agent scope). Also read
# from the keyring entry service `cybermap-shodan`, username `SHODAN_API_KEY`.
SHODAN_API_KEY=

# Hunter (奇安信鹰图) credential for `--engine hunter` (and the merged `-e all` agent scope).
# Also read from the keyring entry service `cybermap-hunter`, username `HUNTER_API_KEY`.
HUNTER_API_KEY=

# DayDayMap API key (个人中心获取, never expires) for `--engine daydaymap`. Also read from the
# keyring entry service `cybermap-daydaymap`, username `DAYDAYMAP_API_KEY`.
DAYDAYMAP_API_KEY=

# Censys Platform personal access token (`censys_...`) for `--engine censys` (host profiles only:
# the Free plan has no search/aggregate endpoint). Also read from the keyring entry service
# `cybermap-censys`, username `CENSYS_API_TOKEN`.
CENSYS_API_TOKEN=

# Page cache: already fetched pages are stored in SQLite and reused instead of spending quota again.
# Disable with `--no-cache` or `cache.enabled: false` in settings.yaml; clear with `--cache-clear`.
CYBERMAP_CACHE_PATH=cybermap-cache.sqlite3
CYBERMAP_CACHE_TTL_HOURS=24

# Config file location (defaults to ./config/settings.yaml, then the per-user path).
CYBERMAP_CONFIG=
# Inline provider configuration as JSON, overriding the providers block of the config file.
CYBERMAP_PROVIDERS_JSON=

# Service authentication. Required when binding REST/MCP HTTP beyond loopback.
CYBERMAP_SERVICE_TOKEN=replace-with-a-long-random-value
CYBERMAP_PORT=8000
CYBERMAP_MCP_PORT=8765
CYBERMAP_BIND_HOST=127.0.0.1
# Windows: use forward slashes in a sqlite URL (sqlite:///C:/path/cybermap.sqlite3).
CYBERMAP_DATABASE_URL=sqlite:///./cybermap.sqlite3
CYBERMAP_ARTIFACT_RETENTION_DAYS=7

# Provider keys are referenced by name from settings.yaml (`api_key_env`); never put values there.
# The preset names below are only read if you point a provider's `api_key_env` at them: this repo
# ships presets for openai/deepseek/anthropic/ollama/lmstudio/custom, so the four vendor names
# are placeholders for user-defined providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
XAI_API_KEY=
MINIMAX_API_KEY=
MIMO_API_KEY=

# Active scanning is opt-in and requires a one-time approval token.
CYBERMAP_ENABLE_SCANNING=false
# Override the Nuclei executable path (defaults to PATH, then the repository directory).
CYBERMAP_NUCLEI=
CYBERMAP_SCAN_APPROVAL_SECRET=
CYBERMAP_NUCLEI_TEMPLATE_ALLOWLIST=
CYBERMAP_NUCLEI_ID_ALLOWLIST=
CYBERMAP_ALLOW_PRIVATE_NETWORK=false

# Required for non-loopback MCP Streamable HTTP protected-resource metadata.
CYBERMAP_MCP_ISSUER_URL=https://auth.example.com
CYBERMAP_MCP_RESOURCE_URL=https://cybermap.example.com/mcp
CYBERMAP_JWT_PUBLIC_KEY=
CYBERMAP_JWT_ISSUER=
CYBERMAP_JWT_AUDIENCE=cybermap
